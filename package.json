{
  "name": "react-raphael",
  "version": "0.9.0",
  "description": "Typed React components for Raphaël vector graphics and animation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/cjs-types.mjs",
    "build:demo": "vite build --config demo/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "raphael": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@types/raphael": "^2.3.10"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "raphael": "^2.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhong1happy/react-raphael.git"
  },
  "keywords": [
    "react",
    "raphael",
    "react-raphael",
    "react-component"
  ],
  "author": "Holly Liu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/liuhong1happy/react-raphael/issues"
  },
  "homepage": "https://github.com/liuhong1happy/react-raphael#readme"
}
